  "narrative": {
    "northStar": "Cybercore",
    "overview": "RapidMaker uses the user-selected cybercore direction: graphite surfaces, lime signals and angular technical headlines, tempered by readable forms. The identity is confident and industrial; controls remain quiet enough for quoting and contact. The inherited RapidMaker SVG logo from github.com/RapidMaker/RapidMaker and green identity anchor the system. No generated raster ships; the former photograph was removed and the scene is procedural.\n\nThe interface is flat and compact. Strong motion belongs to the illustrative manufacturing scene; smaller state transitions make changing values legible. The dark theme is the default, with a complete light comparison theme using the same semantic roles. The chosen catalogue composition is recorded in the surface brief, rather than imposed on every future screen.",
    "keyCharacteristics": [
      "Graphite and lime technical identity.",
      "Oxanium headlines paired with Manrope controls.",
      "Flat, bordered surfaces with small corners.",
      "Visible keyboard focus and motion alternatives."
    ],
    "rules": [
      {
        "name": "The Semantic Theme Rule",
        "body": "Use the shared semantic CSS variables for interface colors; switch their values together when the theme changes.",
        "section": "colors"
      },
      {
        "name": "The Flat Surface Rule",
        "body": "Use tonal separation and borders for panels. Reserve luminous depth for the procedural scene.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do use shared theme variables and the inherited RapidMaker logo.",
      "Do keep labels, keyboard focus and status text visible alongside color changes.",
      "Do use self-hosted Oxanium and Manrope with Tabler outline icons.",
      "Do respect reduced motion and expose pause/replay for sustained scene motion.",
      "Do label illustrative geometry and synthetic prices honestly."
    ],
    "donts": [
      "Don't introduce a boat photograph into this approved surface.",
      "Don't imply that the canvas renders an uploaded STL or that a quote is a submitted order.",
      "Don't add decorative flashing or replace flat panels with generic floating cards.",
      "Don't turn this prototype into checkout or a production upload service without a new scope."
    ]
  }
